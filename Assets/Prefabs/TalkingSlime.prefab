  m_Name: 
  m_EditorClassIdentifier: undream.llmunity.Runtime::LLMUnity.LLMAgent
  advancedOptions: 1
  _remote: 0
  _llm: {fileID: 3163022932191433342}
  _APIKey: 
  _host: localhost
  _port: 13333
  numRetries: 5
